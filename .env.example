# HTTP
HTTP_ADDR=:8081

# Issuer (must match the URL the OP is reachable at; ends up in id_token `iss`)
ISSUER=http://op.local:8081

# Postgres
POSTGRES_USER=oidc
POSTGRES_PASSWORD=oidc
POSTGRES_DB=oidc
DATABASE_URL=postgres://oidc:oidc@postgres:5432/oidc?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Signing keys (ES256). Directory is created on first boot if missing.
KEYS_DIR=/var/lib/op/keys

# go-passkey-auth (the authentication-device service this OP delegates to)
PASSKEY_SERVICE_URL=http://host.docker.internal:8080

# Notifier (auth-device delivery channel)
# One of: log | telegram | whatsapp | webhook
NOTIFIER=log

# Telegram (NOTIFIER=telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# WhatsApp via Meta Cloud API (NOTIFIER=whatsapp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=

# Generic webhook (NOTIFIER=webhook)
WEBHOOK_URL=

# TTLs (Go duration syntax)
AUTH_CODE_TTL=5m
CIBA_REQUEST_TTL=10m
APPROVAL_TOKEN_TTL=5m
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h

# Logging
LOG_LEVEL=INFO
